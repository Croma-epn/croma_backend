# Copia este archivo como .env y completa los valores. El .env NO se sube a Git.

# --- Django ---
SECRET_KEY='genera-una-con-el-comando-del-README'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos local (PostgreSQL) ---
DB_NAME=croma_db_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cuenta de Cloudinary donde se guardan las imágenes: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Para trabajar sin Cloudinary (las imágenes solo viven en memoria):
# ALMACEN_IMAGENES=config.almacenamiento.falso.AlmacenFalso


# --- Solo producción (Heroku los define como config vars; en local no hacen falta) ---
# DATABASE_URL=            # La entrega el add-on de Postgres. Si existe, reemplaza a las DB_*
# CORS_ALLOWED_ORIGINS=https://croma.lat
# CSRF_TRUSTED_ORIGINS=https://api.croma.lat
# SECURE_HSTS_SECONDS=3600
# WEB_CONCURRENCY=2
